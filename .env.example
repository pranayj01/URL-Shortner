PORT=3000
BASE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgresql://postgres:password@localhost:5432/mydb
REDIS_URL=redis://localhost:6379
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Local: copy this file to .env  →  cp .env.example .env
# Render: set these in the dashboard (do not put real secrets in git).
# On Render, BASE_URL / BETTER_AUTH_URL should be https://your-app.onrender.com
# (not localhost). BETTER_AUTH_SECRET must be set on Render (session signing).
