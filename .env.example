PORT=3000
BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/mydb
REDIS_URL=redis://localhost:6379
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Local: copy this file to .env  →  cp .env.example .env
# Render: set these in the dashboard (do not put real secrets in git).
# On Render, BASE_URL should be https://your-app.onrender.com
# or leave it unset so RENDER_EXTERNAL_URL is used.
